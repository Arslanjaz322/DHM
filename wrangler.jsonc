{
  // Cloudflare settings. Replace database_id / bucket_name with your own.
  "name": "website",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-db",
      "database_id": "de1ff0da-e359-47c2-a242-13ec676f4f53",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "website-media" }]
}
